#include <iostream>
#include <vector>
using namespace std;

int main() {
    int n = 120;
    cout << "Numbre of factor : " << n << endl;

    int original = n;
    vector<int> factor;
    vector<int> multiplicity;

    for (int i = 2; i * i <= n; i++) {
        if (n % i == 0) {
            int count = 0;
            while (n % i == 0) {
                n /= i;
                count++;
            }
            factor.push_back(i);
            multiplicity.push_back(count);
        }
    }

    if (n > 1) {
        factor.push_back(n);
        multiplicity.push_back(1);
    }

    cout << "Decomposition of " << original << " : ";
    for (size_t i = 0; i < factor.size(); i++) {
        cout << factor[i];
        if (multiplicity[i] > 1) cout << "^" << multiplicity[i];
        if (i != factor.size() - 1) cout << " * ";
    }
    cout << endl;

    return 0;
}